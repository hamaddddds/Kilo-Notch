<UserControl x:Class="Notch.WaterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <DockPanel>
                <ToggleButton x:Name="Remind" Style="{StaticResource Switch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Click="RemindClick"/>
                <TextBlock>
                    <Run x:Name="Amount" FontSize="36" FontWeight="Bold"/><Run x:Name="Goal" FontSize="15" Foreground="{DynamicResource FgDim}"/>
                </TextBlock>
            </DockPanel>
            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,7">
                <Run Text="Today · "/><Run x:Name="Pct" Foreground="{DynamicResource AccentA}" FontWeight="SemiBold"/><Run x:Name="Note"/>
            </TextBlock>
            <Grid Height="6" Margin="0,0,0,11">
                <Border CornerRadius="3" Background="{DynamicResource SurfaceHi}"/>
                <Border CornerRadius="3" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="FillScale" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SoftBtn}" Click="DrinkClick"
                        MouseRightButtonUp="UndoClick" ToolTip="Right-click to undo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DropIcon" Style="{StaticResource Ico}" Text="&#xEB42;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="DropScale"/>
                                    <TranslateTransform x:Name="DropMove"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Drink" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillBtn}" Margin="8,0,0,0" Click="OpenSettings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE9E9;"/>
                        <TextBlock Text="Settings" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SurfaceHi}" Padding="14,0,0,0">
            <Canvas x:Name="Chart" Width="150" Height="100" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
