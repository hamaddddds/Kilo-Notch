<UserControl x:Class="Notch.ShelfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="Empty" Margin="0,4,0,6">
            <Rectangle RadiusX="14" RadiusY="14" StrokeDashArray="4 3" StrokeThickness="1.2"
                       Stroke="{DynamicResource FgDim}" Fill="{DynamicResource Surface}" Opacity="0.8"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="EmptyIcon" Style="{StaticResource Ico}" Text="&#xE896;" FontSize="22" HorizontalAlignment="Center">
                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                </TextBlock>
                <Button Content="Drop files here or browse" Style="{StaticResource PillBtn}" FontSize="13" Margin="0,6,0,0" Click="Browse"/>
                <TextBlock Style="{StaticResource Dim}" Text="Drag out anytime · click to open" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <DockPanel x:Name="Full" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Style="{StaticResource PillBtn}" Content="Clear" Padding="10,3" FontSize="11" DockPanel.Dock="Right" Click="Clear"/>
                <Button Style="{StaticResource SoftBtn}" Content="+ Add" Padding="10,3" Margin="0,0,5,0" FontSize="11" DockPanel.Dock="Right" Click="Browse"/>
                <Button x:Name="UndoButton" Style="{StaticResource PillBtn}" Content="Undo" Padding="8,3" FontSize="11" DockPanel.Dock="Right" Visibility="Collapsed" Click="Undo"/>
                <TextBlock x:Name="Count" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ScrollSideways">
                <StackPanel x:Name="Items" Orientation="Horizontal" Margin="2,4,2,0"/>
            </ScrollViewer>
        </DockPanel>

        <!-- shown while files hover over the notch -->
        <Grid x:Name="DropZone" Margin="0,4,0,6" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
            <Rectangle x:Name="ZoneFill" RadiusX="14" RadiusY="14" Fill="{DynamicResource AccentSoft}"/>
            <Rectangle x:Name="Ants" RadiusX="14" RadiusY="14" StrokeThickness="1.6" StrokeDashArray="5 4" Stroke="{DynamicResource AccentA}"/>
            <Canvas x:Name="Cards" Width="120" Height="100" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,0,0,0">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="CardsTilt" CenterX="60" CenterY="50"/>
                        <TranslateTransform x:Name="CardsMove"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
            <StackPanel VerticalAlignment="Center" Margin="180,0,16,0">
                <TextBlock Text="Release to add" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="DropInfo" Style="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
