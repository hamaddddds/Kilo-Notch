<UserControl x:Class="Notch.FocusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Notch">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Width="80" Height="80" VerticalAlignment="Center" HorizontalAlignment="Left">
            <local:Ring x:Name="FocusRing" Thickness="7" Brush="{DynamicResource Accent}"/>
            <TextBlock Style="{StaticResource Ico}" Text="&#xE916;" FontSize="26" HorizontalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- the reset button hangs off the right edge so the digits stay centered over the buttons -->
            <Grid HorizontalAlignment="Center">
                <TextBlock x:Name="Time" FontSize="40" FontWeight="Bold" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
                <Button Style="{StaticResource CircleBtn}" Content="&#xE72C;" HorizontalAlignment="Right" Margin="0,0,-40,0" Click="Reset"/>
            </Grid>
            <TextBlock x:Name="ModeText" Style="{StaticResource Dim}" FontSize="13" HorizontalAlignment="Center" Margin="0,-2,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BreakBtn" Style="{StaticResource PillBtn}" Click="BreakMode">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xEC32;"/>
                        <TextBlock Text="Short Break" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PlayBtn" Style="{StaticResource AccentBtn}" Width="58" Margin="8,0" Click="Toggle"
                        FontFamily="{StaticResource Icons}"/>
                <Button x:Name="FocusBtn" Style="{StaticResource PillBtn}" Click="FocusMode">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xF272;"/>
                        <TextBlock Text="Focus Time" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
