<UserControl x:Class="Notch.TodoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="Score" FontSize="38" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource Dim}" FontSize="13" Text="Task Done Today" Margin="0,-4,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PillBtn}" Padding="10,7" Click="AddTask">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE710;"/>
                        <TextBlock Text="Add Task" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EditBtn" Style="{StaticResource PillBtn}" Padding="10,7" Margin="6,0,0,0" Click="EditTasks">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE70F;"/>
                        <TextBlock Text="Edit" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <DockPanel Grid.Column="1">
            <Border x:Name="Editor" DockPanel.Dock="Top" CornerRadius="10" Padding="10,5" Margin="0,0,0,6" Visibility="Collapsed"
                    Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource AccentA}">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="TaskBox" Style="{StaticResource Field}" KeyDown="EditorKey" TextChanged="EditorChanged"/>
                        <TextBlock x:Name="TaskHint" Style="{StaticResource Dim}" FontSize="13" Text="New task…" Margin="3,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                    <DockPanel Margin="0,4,0,0">
                        <Button Content="Save" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Style="{StaticResource SoftBtn}" Click="SaveTask"/>
                        <Button x:Name="TimeButton" Content="No reminder ▾" Padding="4,3" FontSize="11" Style="{StaticResource PillBtn}" Click="PickTime" HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Grid>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource Dim}" Text="Nothing to do. Nice." FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="Tasks"/>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
