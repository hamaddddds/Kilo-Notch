<Window x:Class="Notch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notch"
        Title="Notch" Width="780" Height="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource Ui}" Foreground="{DynamicResource Fg}"
        TextOptions.TextRenderingMode="Grayscale">

    <!-- The window never resizes: springs redraw the notch shape each frame, so morphing costs no layout. -->
    <Grid x:Name="Root" AllowDrop="True" MouseEnter="NotchEnter" MouseLeave="NotchLeave" MouseWheel="NotchWheel"
          DragEnter="NotchDragEnter" DragOver="NotchDragOver" DragLeave="NotchDragLeave" Drop="NotchDrop">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Settings" Click="OpenSettings"/>
                <MenuItem Header="Exit" Click="Exit"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- shadow on its own layer so content changes never re-run the blur -->
        <Path x:Name="ShadowShape" Fill="Black" IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>
        <Path x:Name="NotchShape" Fill="{DynamicResource NotchBg}"/>
        <Path x:Name="GlowShape" IsHitTestVisible="False" Opacity="0">
            <Path.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0.2"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Path.OpacityMask>
        </Path>

        <!-- each view has a fixed size and is centered, so nothing reflows while the notch morphs -->
        <Grid x:Name="Body">
            <!-- light that rises from the bottom while files hover, and rolls out as a wave on drop -->
            <local:DropGlow x:Name="DropLight"/>

            <Grid x:Name="RestingView" Width="150" Height="38" VerticalAlignment="Top" HorizontalAlignment="Center"
                  RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                <local:Kilo x:Name="Face" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                <!-- notes that float up while Kilo dances -->
                <TextBlock x:Name="NoteL" Text="&#x266A;" FontFamily="Segoe UI Symbol" FontSize="13" HorizontalAlignment="Left"
                           VerticalAlignment="Center" Margin="34,0,0,0" Opacity="0">
                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="NoteR" Text="&#x266B;" FontFamily="Segoe UI Symbol" FontSize="13" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,34,0" Opacity="0">
                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <Grid x:Name="ClosedView" Width="236" Height="38" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Visibility="Collapsed" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                <Grid HorizontalAlignment="Left" Margin="16,0,0,0" Width="20" Height="20">
                    <local:Ring x:Name="ClosedRing" Thickness="3"/>
                    <Border x:Name="ClosedArt" CornerRadius="5" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="ClosedTime" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <local:Wave x:Name="ClosedWave" Width="22" Height="16" HorizontalAlignment="Right" Margin="0,0,16,0"
                            Brush="{DynamicResource Accent}"/>
            </Grid>

            <Grid x:Name="PeekView" Width="330" Height="58" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Visibility="Collapsed" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                <Grid HorizontalAlignment="Left" Margin="16,0,0,0" Width="38" Height="38">
                    <local:Ring x:Name="PeekRing" Thickness="3.5"/>
                    <TextBlock x:Name="PeekGlyph" Style="{StaticResource Ico}" FontSize="15" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel x:Name="PeekText" Margin="66,0,84,0" VerticalAlignment="Center">
                    <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                    <TextBlock x:Name="PeekTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PeekSub" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="PeekRight" FontSize="26" FontWeight="Light" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Border x:Name="PeekBadge" Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Right" Margin="0,0,14,0"
                        Background="{DynamicResource Surface}" BorderThickness="2" BorderBrush="{DynamicResource Accent}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <TextBlock x:Name="PeekBadgeGlyph" Style="{StaticResource Ico}" FontSize="16" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <Grid x:Name="OpenView" Width="500" Height="188" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Visibility="Collapsed" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Margin="22,8,22,0">
                    <TextBlock x:Name="PageTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Ring x:Name="HeadRing" Width="16" Height="16" Thickness="2.5" Margin="0,0,8,0"/>
                        <TextBlock x:Name="HeadDate" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeadTime" FontSize="13" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <local:Wave x:Name="HeadWave" Width="18" Height="14" HorizontalAlignment="Right" Brush="{DynamicResource Fg}"/>
                </Grid>
                <ContentControl x:Name="PageHost" Grid.Row="1" Margin="50,2,50,0" Focusable="False"/>
                <Button x:Name="PrevPage" Grid.Row="1" Style="{StaticResource CircleBtn}" Content="&#xE76B;"
                        HorizontalAlignment="Left" Margin="12,0,0,0" Click="PagePrev"/>
                <Button x:Name="NextPage" Grid.Row="1" Style="{StaticResource CircleBtn}" Content="&#xE76C;"
                        HorizontalAlignment="Right" Margin="0,0,12,0" Click="PageNext"/>
                <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- the photo booth's flash -->
            <Border x:Name="FlashLayer" Background="White" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
